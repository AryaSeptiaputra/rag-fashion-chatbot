# ---- Claude API ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ---- Supabase ----
# SUPABASE_SERVICE_KEY dipakai backend (bypass RLS). Jangan pernah dikirim ke frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Embedding (HuggingFace lokal) ----
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION=faq

# ---- Ingestion ----
FAQ_SOURCE_DIR=data/raw/faq
CHUNK_SIZE=320
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=4

# ---- Agent ----
AGENT_MAX_ITERATIONS=8
HISTORY_TURN_LIMIT=10

# ---- Observability ----
# text (development) | json (production)
LOG_FORMAT=text

# ---- Demo UI ----
# Base URL API yang dipanggil Streamlit
API_BASE_URL=http://localhost:8000

# ---- Kontak eskalasi (dipakai tool escalate_to_human) ----
SUPPORT_CONTACT=admin@brand.example
