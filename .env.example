# ---- Claude API ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ---- Harga model (USD per juta token) ----
# Default = tarif Claude Haiku 4.5. WAJIB dicek ulang di halaman pricing
# Anthropic setiap kali LLM_MODEL diganti; tidak ada yang memvalidasinya.
PRICE_INPUT_PER_MTOK=1.00
PRICE_OUTPUT_PER_MTOK=5.00
PRICE_CACHE_READ_PER_MTOK=0.10
PRICE_CACHE_WRITE_PER_MTOK=1.25

# ---- Supabase ----
# SUPABASE_SERVICE_KEY dipakai backend (bypass RLS). Jangan pernah dikirim ke frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Embedding (HuggingFace lokal) ----
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION=faq

# ---- Ingestion ----
FAQ_SOURCE_DIR=data/raw/faq
CHUNK_SIZE=320
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=4

# ---- Agent ----
AGENT_MAX_ITERATIONS=8
HISTORY_TURN_LIMIT=10

# ---- Observability ----
# text (development) | json (production)
LOG_FORMAT=text

# ---- Mode demo ----
# true = endpoint chat melayani jawaban contoh dari fixture dan TIDAK pernah
# memanggil Anthropic. Dipakai membangun dan memperagakan UI tanpa saldo API.
DEMO_STUB_LLM=false

# Kunci HMAC cookie identitas pengunjung. Kalau kosong, dipakai kunci acak
# per-proses: tanda tangannya tetap tidak bisa dipalsukan, tapi kuota pengunjung
# ikut direset tiap kali server restart.
DEMO_SIGNING_KEY=

# ---- Kuota berlapis ----
# Ketiganya harus lolos sebelum satu pertanyaan dilayani. Lapis pengunjung
# menahan tab dan sesi baru, lapis IP menahan penghapus cookie, dan plafon
# anggaran menahan sisanya termasuk VPN. Semuanya per-proses dan hilang saat
# restart, jadi jalankan uvicorn dengan SATU worker.
DEMO_VISITOR_DAILY_QUOTA=8
DEMO_IP_DAILY_QUOTA=24
DEMO_DAILY_BUDGET_USD=0.10
DEMO_MESSAGE_MAX_CHARS=500
DEMO_FACTS_TTL_SECONDS=300

# Jumlah proxy tepercaya di depan aplikasi. 0 = X-Forwarded-For diabaikan
# sepenuhnya, karena header itu bisa dipalsukan siapa saja. Lebih baik lagi:
# jalankan uvicorn dengan --proxy-headers --forwarded-allow-ips=<ip proxy>.
TRUSTED_PROXY_COUNT=0

# ---- Frontend ----
# Frontend disajikan dari proses yang sama, jadi same-origin dan tidak butuh
# CORS. Isi hanya saat mengembangkan halaman dari disk; kosong = middleware
# CORS tidak dipasang sama sekali.
CORS_ALLOW_ORIGINS=

# ---- Kontak eskalasi (dipakai tool escalate_to_human) ----
SUPPORT_CONTACT=admin@brand.example
