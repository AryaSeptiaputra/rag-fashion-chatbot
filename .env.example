# ---- Ollama (LLM lokal) ----
# Prasyarat: server Ollama jalan dan modelnya sudah di-pull.
#   ollama pull qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434

# ---- LLM utama (memilih dan memanggil tool) ----
LLM_MODEL=qwen3:1.7b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# num_ctx Ollama. Default bawaannya terlalu kecil untuk system prompt +
# skema 8 tool + riwayat + hasil tool.
LLM_CONTEXT_WINDOW=8192
LLM_REQUEST_TIMEOUT=180
# Tahan bobot di VRAM antar-request; tanpa ini tiap giliran bayar cold start.
LLM_KEEP_ALIVE=10m
# Qwen3 punya thinking mode. Dimatikan supaya jejak penalaran tidak bocor
# ke jawaban pembeli dan tiap giliran tidak melar.
LLM_THINKING=false

# ---- LLM penyusun jawaban akhir ----
COMPOSER_MODEL=qwen3:1.7b
COMPOSER_MAX_TOKENS=512
COMPOSER_TEMPERATURE=0.1
COMPOSER_HISTORY_TURNS=2

# ---- LLM juri untuk RAGAS dan DeepEval ----
# Sengaja lebih besar dari model yang diuji: model yang menilai jawabannya
# sendiri bukan pengukuran. Hanya dipakai oleh harness eval, tidak oleh aplikasi.
#   ollama pull qwen2.5:7b-instruct
#   ollama pull nomic-embed-text
JUDGE_MODEL=qwen2.5:7b-instruct
JUDGE_EMBEDDING_MODEL=nomic-embed-text
JUDGE_TEMPERATURE=0.0

# ---- Supabase ----
# SUPABASE_SERVICE_KEY dipakai backend (bypass RLS). Jangan pernah dikirim ke frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Embedding (HuggingFace lokal) ----
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION=faq

# ---- Ingestion ----
FAQ_SOURCE_DIR=data/raw/faq
CHUNK_SIZE=320
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=4

# ---- Agent ----
AGENT_MAX_ITERATIONS=5
HISTORY_TURN_LIMIT=10

# ---- Observability ----
# text (development) | json (production)
LOG_FORMAT=text

# ---- Demo UI ----
# Base URL API yang dipanggil Streamlit
API_BASE_URL=http://localhost:8000

# ---- Kontak eskalasi (dipakai tool escalate_to_human) ----
SUPPORT_CONTACT=admin@brand.example
